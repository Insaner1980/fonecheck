{
  "name": "fonecheck-deepsec-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSec scanning workspace for fonecheck",
  "type": "module",
  "workspaces": [],
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "deepsec": "deepsec",
    "deepsec:scan": "deepsec scan --project-id fonecheck",
    "deepsec:process": "deepsec process --project-id fonecheck --agent codex --model gpt-5.6-luna",
    "deepsec:revalidate": "deepsec revalidate --project-id fonecheck --agent codex --model gpt-5.6-luna --min-severity MEDIUM",
    "deepsec:export": "deepsec export --project-id fonecheck --format md-dir --out ./findings",
    "deepsec:report": "pnpm run deepsec:scan && pnpm run deepsec:process && pnpm run deepsec:revalidate && pnpm run deepsec:export",
    "deepsec:report:custom": "pnpm run deepsec:report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "deepsec": "2.3.9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.7",
      "hono": "4.13.7",
      "qs": "6.16.0",
      "undici@8.5.0": "8.10.0"
    }
  }
}
