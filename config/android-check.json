{
  "schemaVersion": 1,
  "exceptionsFile": "config/check-exceptions.json",
  "projectId": "fonecheck",
  "modules": [
    {
      "path": ":app",
      "relativePath": "app",
      "kind": "android-application",
      "required": true,
      "variants": ["debug", "release"],
      "sourceSets": ["main", "debug", "test", "androidTest"]
    }
  ],
  "buildTasks": [":app:assembleDebug"],
  "testTasks": [":app:testDebugUnitTest"],
  "includedBuilds": [
    {
      "path": "tools/stability-analyzer",
      "sourceModules": [
        {
          "path": "compose-stability-compiler",
          "sourceSets": ["main", "test"]
        },
        {
          "path": "compose-stability-gradle",
          "sourceSets": ["main", "test"]
        }
      ],
      "dependencyTasks": [
        ":stability-analyzer:compose-stability-compiler:dependencies",
        ":stability-analyzer:compose-stability-gradle:dependencies"
      ]
    }
  ],
  "checks": {
    "dependabotEnabled": true,
    "ktlintTasks": [":app:ktlintCheck"],
    "detektTasks": [":app:detekt"],
    "lintTasks": [":app:lintDebug"],
    "stabilityTasks": [":app:stabilityCheck"],
    "dependencyConfigurations": ["debugRuntimeClasspath", "releaseRuntimeClasspath"],
    "dependencyCheckTasks": [":app:dependencyCheckAnalyze"],
    "semgrepConfig": "config/semgrep/fonecheck-security.yml"
  }
}
